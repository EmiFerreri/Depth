    "/levels/generate": {
      "get": {
        "operationId": "generateLevelFromQuery",
        "summary": "Generate one reproducible room",
        "description": "Duplicate parameters are rejected. Query integer syntax is decimal digits only.",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "story",
                "expedition"
              ],
              "default": "expedition"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,48}$",
              "default": "LUMA",
              "description": "Expedition seed, normalized to uppercase. Ignored in story."
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1,
              "description": "Story maximum 100. Cannot exceed a nonzero expedition length."
            }
          },
          {
            "name": "intensity",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1,
              "description": "Expedition only. Story normalizes to 1."
            }
          },
          {
            "name": "length",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                12,
                36
              ],
              "default": 12,
              "description": "0 means Abismo, capped at 100000 rooms. Story normalizes to 12."
            }
          },
          {
            "name": "worldId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "vestibule",
                "gardens",
                "archives",
                "nexus",
                "core"
              ],
              "description": "Omit to mix worlds. Available in expedition v5 only."
            }
          },
          {
            "name": "generatorVersion",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                4,
                5
              ],
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedLevel"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Foreign origin or nonlocal Host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
