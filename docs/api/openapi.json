  "components": {
    "schemas": {
      "GenerateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "story",
              "expedition"
            ],
            "default": "expedition"
          },
          "seed": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$",
            "default": "LUMA",
            "description": "Expedition seed, normalized to uppercase. Ignored in story."
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "default": 1,
            "description": "Story maximum 100. Cannot exceed a nonzero expedition length."
          },
          "intensity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 1,
            "description": "Expedition only. Story normalizes to 1."
          },
          "length": {
            "type": "integer",
            "enum": [
              0,
              12,
              36
            ],
            "default": 12,
            "description": "0 means Abismo, capped at 100000 rooms. Story normalizes to 12."
          },
          "worldId": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "vestibule",
              "gardens",
              "archives",
              "nexus",
              "core"
            ],
            "default": null,
            "description": "Explicit world requires expedition and generatorVersion 5. Null mixes all worlds."
          },
          "generatorVersion": {
            "type": "integer",
            "enum": [
              4,
              5
            ],
            "default": 5
          }
        },
        "examples": [
          {
            "mode": "expedition",
            "seed": "LUMA-RECUERDA",
            "level": 1,
            "intensity": 3,
            "length": 36,
            "worldId": "archives",
            "generatorVersion": 5
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "story"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "properties": {
                "level": {
                  "maximum": 100
                },
                "worldId": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "generatorVersion": {
                  "const": 4
                }
              },
              "required": [
                "generatorVersion"
              ]
            },
            "then": {
              "properties": {
                "worldId": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "BatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "story",
              "expedition"
            ],
            "default": "expedition"
          },
          "seed": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$",
            "default": "LUMA",
            "description": "Expedition seed, normalized to uppercase. Ignored in story."
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "default": 1,
            "description": "Story maximum 100. Cannot exceed a nonzero expedition length."
          },
          "intensity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 1,
            "description": "Expedition only. Story normalizes to 1."
          },
          "length": {
            "type": "integer",
            "enum": [
              0,
              12,
              36
            ],
            "default": 12,
            "description": "0 means Abismo, capped at 100000 rooms. Story normalizes to 12."
          },
          "worldId": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "vestibule",
              "gardens",
              "archives",
              "nexus",
              "core"
            ],
            "default": null,
            "description": "Explicit world requires expedition and generatorVersion 5. Null mixes all worlds."
          },
          "generatorVersion": {
            "type": "integer",
            "enum": [
              4,
              5
            ],
            "default": 5
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 1
          }
        },
        "description": "Same rules as GenerateRequest. Generates count consecutive rooms beginning at level; rejects the entire request if any room exceeds the run length."
      },
      "Validation": {
        "type": "object",
        "required": [
          "valid",
          "errors",
          "reachability"
        ],
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reachability": {
            "type": "string",
            "const": "not-run"
          }
        },
        "description": "Structural checks only. No physics solver, safety proof or human difficulty rating."
      },
      "GeneratedLevel": {
        "type": "object",
        "required": [
          "schemaVersion",
          "generatorVersion",
          "id",
          "parameters",
          "world",
          "validation"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "generatorVersion": {
            "enum": [
              4,
              5
            ]
          },
          "id": {
            "type": "string"
          },
          "parameters": {
            "$ref": "#/components/schemas/GenerateRequest"
          },
          "world": {
            "$ref": "#/components/schemas/World"
          },
          "validation": {
            "$ref": "#/components/schemas/Validation"
          }
        }
      },
      "Batch": {
        "type": "object",
        "required": [
          "schemaVersion",
          "count",
          "levels"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "levels": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/GeneratedLevel"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "status",
              "message"
            ],
            "properties": {
              "status": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Entity": {
        "type": "object",
        "required": [
          "id",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      },
      "World": {
        "type": "object",
        "required": [
          "seed",
          "length",
          "sectors",
          "levelInfo",
          "motion",
          "platforms",
          "hazards",
          "pickups",
          "rails",
          "enemies",
          "clue",
          "gate",
          "echo"
        ],
        "description": "Engine-ready initial snapshot with deterministic geometry, puzzle rules and narrative. Fresh generation only; the game mutates it during simulation. V4 omits biome and feature arrays. Do not treat structural validation as authorization to execute arbitrary imported worlds.",
        "properties": {
          "seed": {
            "type": "string"
          },
          "length": {
            "type": "number",
            "minimum": 1800,
            "maximum": 6000
          },
          "sectors": {
            "const": 1
          },
          "levelInfo": {
            "type": "object",
            "required": [
              "id",
              "mode",
              "level",
              "chapter",
              "rules",
              "difficulty",
              "title",
              "clue",
              "help",
              "echo"
            ]
          },
          "motion": {
            "type": "object",
            "required": [
              "speed",
              "response"
            ]
          },
          "clue": {
            "type": "object"
          },
          "gate": {
            "type": "object"
          },
          "echo": {
            "type": "object"
          },
          "biome": {
            "type": "object"
          },
          "abilitiesEnabled": {
            "type": "boolean"
          },
          "platforms": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/Entity"
            }
          },
          "hazards": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/Entity"
            }
          },
          "pickups": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/Entity"
            }
          },
          "rails": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "$ref": "#/components/schemas/Entity"
            }
          },
          "enemies": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "$ref": "#/components/schemas/Entity"
            }
          },
          "supports": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Entity"
            }
          },
          "fields": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Entity"
            }
          },
          "springs": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Entity"
            }
          },
          "sentinels": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Entity"
            }
          }
        }
      },
      "Catalog": {
        "type": "object",
        "required": [
          "schemaVersion",
          "generatorVersions",
          "worlds",
          "chapters",
          "levels",
          "characters",
          "abilities",
          "obstacles",
          "rewards",
          "memories"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "generatorVersions": {
            "type": "array",
            "items": {
              "enum": [
                4,
                5
              ]
            }
          },
          "worlds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ]
            }
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ]
            }
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ]
            }
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ]
            }
          },
          "abilities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ]
            }
          },
          "obstacles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ]
            }
          },
          "rewards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ]
            }
          },
          "memories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ]
            }
          }
        }
      }
    }
  }
