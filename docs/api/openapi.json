{
  "openapi": "3.1.0",
  "info": {
    "title": "DEPTH Procedural API",
    "version": "1.0.0",
    "description": "Local, stateless, deterministic generation for DEPTH 0.5.0. Node 20+. No key, external AI, persistence or hosted endpoint. Requests are capped at 64 KiB and batches at 20 rooms. Bound to 127.0.0.1; same-origin HTTP requests or local scripts only. HEAD also supported for catalog and health routes. No automatic physics reachability check."
  },
