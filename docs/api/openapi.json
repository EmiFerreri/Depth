      "post": {
        "operationId": "generateLevel",
        "summary": "Generate one reproducible room",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              },
              "example": {
                "mode": "expedition",
                "seed": "LUMA-RECUERDA",
                "level": 1,
                "intensity": 3,
                "length": 36,
                "worldId": "archives",
                "generatorVersion": 5
              }
